{
  "rewrites": [
    {
      "source": "/projects/syndicai",
      "destination": "/projects/syndicai/index.html"
    },
    {
      "source": "/projects/gym-coaching-saas",
      "destination": "/projects/gym-coaching-saas/index.html"
    },
    {
      "source": "/projects/cfqma-platform",
      "destination": "/projects/cfqma-platform/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}